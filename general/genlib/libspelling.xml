    <bridgehead renderas="sect3">libspelling Dependencies</bridgehead>

    <bridgehead renderas="sect4">Required</bridgehead>
    <para role="required">
      <xref linkend="enchant"/>,
      <xref linkend="icu"/>, 
      <xref linkend="gtk4"/>, 
      <xref linkend="gtksourceview5"/>, and
      <xref linkend="vala"/>
